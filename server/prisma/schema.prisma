generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The child. Owns parent profiles and sees the dashboard.
model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  phone          String? // child's WhatsApp number, for alerts
  // Also send "not done yet" alerts to WhatsApp (HELP alerts always go when a phone is set).
  whatsappAlerts Boolean         @default(true)
  timezone       String? // the child's own, from their browser; used to label times in alerts
  createdAt      DateTime        @default(now())
  parents        ParentProfile[] // parents this user added (the owner)
  careOf         CareMember[] // parents shared with this user
  invitesSent    CareInvite[]
  notes          CareNote[]
  notifications  Notification[]
  passwordResets PasswordReset[]
  // Bumped on password reset: sessions signed with an older version stop working.
  tokenVersion   Int             @default(0)
  // A short 1 PM note on WhatsApp about how the parent's day is going so far.
  middaySummary  Boolean         @default(false)
  plan           Plan            @default(FREE)
  planRenewsAt   DateTime? // end of the paid period; null while on the free plan
  trialEndsAt    DateTime? // Family plan features are open until then
  voiceClips     VoiceClip[]
  checkIns       CheckIn[]
}

enum Plan {
  FREE
  FAMILY // ₹199 a month
}

// Siblings and other family members who share a parent's dashboard and alerts.
// The parent's `userId` is the owner; members can do everything except remove the parent
// or manage who else is on the team.
model CareMember {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([parentId, userId])
}

model CareInvite {
  id          String        @id @default(cuid())
  parentId    String
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  email       String
  token       String        @unique
  invitedById String
  invitedBy   User          @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // only the hash is stored; the link carries the token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
  REVOKED
}

model ParentProfile {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String // how the child addresses them, e.g. "Mummy"
  relationship    String
  // WhatsApp id format: country code + number, digits only (e.g. 919812345678).
  // Unique: one profile per parent; siblings share it through CareMember.
  phone           String              @unique
  timezone        String              @default("Asia/Kolkata")
  emergencyNumber String              @default("112")
  language        Language            @default(HINGLISH) // for every WhatsApp message to them
  consentStatus   ConsentStatus       @default(PENDING)
  consentAt       DateTime?
  lastInboundAt   DateTime? // drives WhatsApp's 24h session window
  createdAt       DateTime            @default(now())
  routines        Routine[]
  occurrences     RoutineOccurrence[]
  events          HealthEvent[]
  messages        Message[]
  alerts          Alert[]
  notifications   Notification[]
  members         CareMember[]
  invites         CareInvite[]
  medicines       Medicine[]
  appointments    Appointment[]
  notes           CareNote[]
  voiceClips      VoiceClip[]
  checkIns        CheckIn[]
  memories        Memory[]
}

enum Language {
  HINGLISH
  HINDI // Devanagari script
  ENGLISH
}

// A medicine as the doctor prescribed it. Dose and instructions are stored and repeated
// exactly as entered: the product never changes or suggests medication instructions.
model Medicine {
  id              String        @id @default(cuid())
  parentId        String
  parent          ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name            String // "Telma 40"
  dose            String? // "1 tablet"
  instructions    String? // "after breakfast", as written on the prescription
  prescribedBy    String?
  pillsLeft       Int? // optional stock count for refill alerts
  pillsPerDose    Int           @default(1)
  refillAlertDays Int           @default(5)
  refilledAt      DateTime? // one refill alert per refill
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  routines        Routine[]
}

enum AppointmentStatus {
  UPCOMING
  DONE
  CANCELLED
}

model Appointment {
  id                String            @id @default(cuid())
  parentId          String
  parent            ParentProfile     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  title             String // "Dr. Sharma (heart)"
  place             String?
  at                DateTime
  notes             String?
  remindParent      Boolean           @default(true)
  status            AppointmentStatus @default(UPCOMING)
  remindedDayBefore DateTime?
  remindedSameDay   DateTime?
  createdAt         DateTime          @default(now())
}

// Shared family notes: "Doctor said less salt", "Calls are best after 7 PM".
model CareNote {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String
  pinned    Boolean       @default(false)
  createdAt DateTime      @default(now())
}

enum RoutineType {
  MEDICINE
  WATER
  BP
  SUGAR
  WALK
  WELLBEING
}

enum Frequency {
  DAILY // every day
  WEEKLY // on the days in daysOfWeek (e.g. a Sunday sugar test)
  INTERVAL // every intervalDays days, counted from startDate
  MONTHLY // on dayOfMonth (29-31 fall back to the month's last day)
}

model Routine {
  id                String              @id @default(cuid())
  parentId          String
  parent            ParentProfile       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  type              RoutineType
  name              String // "morning wali dawa"
  timeOfDay         String // "HH:mm" in the parent's timezone
  frequency         Frequency           @default(DAILY)
  daysOfWeek        Int[] // WEEKLY: 1 = Mon … 7 = Sun
  intervalDays      Int? // INTERVAL
  startDate         String? // INTERVAL anchor, "YYYY-MM-DD" in the parent's timezone
  dayOfMonth        Int? // MONTHLY
  target            Int? // e.g. glasses of water per day
  medicineId        String?
  medicine          Medicine?           @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  // The child's own words for this reminder. When empty, the standard warm wording is used.
  message           String?
  // Played to the parent right after this reminder: the child's own voice.
  voiceClipId       String?
  voiceClip         VoiceClip?          @relation(fields: [voiceClipId], references: [id], onDelete: SetNull)
  // Care rules. null = off.
  followUpMinutes   Int?                @default(60) // one gentle follow-up to the parent
  alertAfterMinutes Int?                @default(180) // tell the child if still not done
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  occurrences       RoutineOccurrence[]
  notifications     Notification[]
}

// One instance of a routine on one day. This is "the question waiting for an answer".
enum OccurrenceStatus {
  SCHEDULED // created, reminder not yet sent
  SENT // reminder sent, waiting for a reply
  DONE // parent confirmed
  NOT_DONE // parent explicitly said no / not yet
  NO_RESPONSE // day ended without a reply. Missing data, not a missed dose.
}

model RoutineOccurrence {
  id             String           @id @default(cuid())
  routineId      String
  routine        Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  parentId       String
  parent         ParentProfile    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  localDate      String // "2026-10-16" in the parent's timezone
  scheduledFor   DateTime
  status         OccurrenceStatus @default(SCHEDULED)
  sentAt         DateTime?
  respondedAt    DateTime?
  followUpAt     DateTime? // when the follow-up nudge went to the parent
  childAlertedAt DateTime? // when the child was told it wasn't done
  note           String? // "after breakfast"
  events         HealthEvent[]

  @@unique([routineId, localDate])
  @@index([parentId, status])
  @@index([parentId, localDate])
}

enum Direction {
  IN
  OUT
}

// Every WhatsApp message in either direction. The conversation log.
model Message {
  id           String         @id @default(cuid())
  parentId     String?
  parent       ParentProfile? @relation(fields: [parentId], references: [id], onDelete: Cascade)
  direction    Direction
  toPhone      String?
  body         String
  kind         String // text | button | session | template | dropped
  buttons      Json? // [{id,title}] offered on outbound messages
  payload      String? // button id the parent tapped
  waMessageId  String?        @unique // dedupe for webhook retries
  handledBy    String? // RULES | LLM | BUTTON | NONE
  occurrenceId String?
  voiceClipId  String? // an audio message: which clip was sent
  createdAt    DateTime       @default(now())
  events       HealthEvent[]

  @@index([parentId, createdAt])
}

enum EventType {
  MEDICINE
  BP
  SUGAR
  WATER
  WEIGHT
  WALK
  WELLBEING
  SYMPTOM
}

enum EventSource {
  BUTTON
  RULES
  LLM
  DASHBOARD
}

model HealthEvent {
  id           String             @id @default(cuid())
  parentId     String
  parent       ParentProfile      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  type         EventType
  valueNum     Float? // systolic, sugar mg/dL, glasses, kg
  valueNum2    Float? // diastolic
  valueText    String? // "taken", "good", "knee pain"
  unit         String?
  context      String? // "after breakfast", "fasting", "since yesterday"
  occurredAt   DateTime
  source       EventSource
  messageId    String?
  message      Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  occurrenceId String?
  occurrence   RoutineOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([parentId, type, occurredAt])
}

// Raised only by an explicit parent action (HELP / emergency button), never by AI.
model Alert {
  id             String        @id @default(cuid())
  parentId       String
  parent         ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  kind           String // EMERGENCY
  messageId      String?
  createdAt      DateTime      @default(now())
  acknowledgedAt DateTime?
}

// What the child is told: things not done, silence, HELP, and updates when things resolve.
model Notification {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     String
  parent       ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  routineId    String?
  routine      Routine?      @relation(fields: [routineId], references: [id], onDelete: SetNull)
  occurrenceId String?
  kind         String // NOT_DONE | RESOLVED | SILENCE | HELP
  title        String
  body         String
  dedupeKey    String        @unique // one notification per event, however often the rules run
  createdAt    DateTime      @default(now())
  readAt       DateTime?
  whatsappAt   DateTime?

  @@index([userId, createdAt])
}

// A short recording in the child's own voice, sent to the parent with reminders or on its own.
// Kept in Postgres while clips are small (≤ 1 MB); object storage is the place once they grow.
model VoiceClip {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  label     String // "Good morning, Mummy"
  mime      String
  data      Bytes
  seconds   Int
  createdAt DateTime      @default(now())
  routines  Routine[]
  checkIns  CheckIn[]
}

// The child asking "how are you?" in the middle of the day, with one-tap answers.
model CheckIn {
  id          String        @id @default(cuid())
  parentId    String
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  fromId      String
  from        User          @relation(fields: [fromId], references: [id], onDelete: Cascade)
  text        String
  voiceClipId String?
  voiceClip   VoiceClip?    @relation(fields: [voiceClipId], references: [id], onDelete: SetNull)
  answer      String? // good | okay | low
  answeredAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([parentId, createdAt])
}

enum MemoryStatus {
  SUGGESTED // noticed in the messages, waiting for the family to keep or dismiss
  KEPT
  DISMISSED // stays dismissed: the same pattern is never suggested again
}

// Something worth remembering about the parent, always with the messages it came from.
// Found by deterministic workers over stored records; nothing here is a diagnosis.
model Memory {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  key       String // identifies the pattern, e.g. "symptom:knee pain"
  kind      String // HEALTH | HABIT | PREFERENCE
  text      String
  evidence  Json // [{ at, quote }]
  status    MemoryStatus  @default(SUGGESTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([parentId, key])
}
