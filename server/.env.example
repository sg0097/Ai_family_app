DATABASE_URL=postgresql://familycare:familycare@localhost:5434/familycare
REDIS_URL=redis://localhost:6381
PORT=4200
JWT_SECRET=change-me
WEB_ORIGIN=http://localhost:5180

# fake = log messages locally and use the dev simulator; meta = WhatsApp Cloud API
WHATSAPP_PROVIDER=fake
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_TEMPLATE_LANGUAGE=en

# Language understanding. Leave OLLAMA_URL empty to run rules-only.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# all | api | worker
ROLE=all

# Links in emails (password reset, family invites). Defaults to WEB_ORIGIN.
APP_URL=
# fake = print emails to the server log; resend = send via Resend (needs RESEND_API_KEY)
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM=Family Care <care@example.com>
# live = real service; demo = simulated WhatsApp with a visible banner
APP_MODE=live
